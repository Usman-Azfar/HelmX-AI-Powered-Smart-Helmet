{
  "description": "Offline application of the HelmX validation protocol to three simpler, non-neural detectors (single-threshold accel-peak and gyro-peak rules; 7-feature logistic regression). Same split, windowing, validation-only threshold calibration, deployed event rule (3 windows + 60 s cooldown), frozen external sets, unseen-DaRUS retrain, and causal-filter replay. No Raspberry Pi hardware runs.",
  "detectors": {
    "accel_peak_rule": "score = peak |a| (m/s^2, gravity removed) in the 1.2 s window",
    "gyro_peak_rule": "score = peak |omega| (deg/s) in the 1.2 s window",
    "logreg_7feat": "StandardScaler + LogisticRegression(C=1, class_weight=balanced) on accel_mag_mean, accel_mag_std, accel_mag_peak, gyro_mag_mean, gyro_mag_std, gyro_mag_peak, jerk_peak_per_sample",
    "helmx_classifier": "frozen HelmX classifier head, classifier_prob_balanced threshold",
    "helmx_deployed_or_rule": "frozen HelmX classifier OR reconstruction rule (deployed)"
  },
  "label_circularity_caveat": "Outside DaRUS, positive windows are chosen by the top-30% peak-|a| heuristic, which is accel_peak_rule's own score; see held_out_test.stratified_by_label_source.",

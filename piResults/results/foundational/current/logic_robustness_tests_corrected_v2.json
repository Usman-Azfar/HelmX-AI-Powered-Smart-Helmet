  "W2-R4_old_new_samples_never_mixed": {
    "buffer_always_empty_immediately_after_clear_on_detected_gap": true,
    "note": "SampleStreamGuard calls scorer.clear() BEFORE the arriving sample is appended -- checked directly here (buffer length read right after clear(), before the new sample is appended) -- so the buffer is provably empty at that point on every detected gap; a scored window can never span samples from before and after a detected gap. (The buffer length BEFORE clear() is normally nonzero -- that's the stale in-flight window being correctly discarded, not a violation.)"
  },
